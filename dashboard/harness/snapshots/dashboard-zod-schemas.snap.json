    "additionalProperties": false,
    "properties": {
      "limit": {
        "default": 25,
        "maximum": 200,
        "minimum": 1,
        "type": "integer"
      },
      "q": {
        "minLength": 2,
        "type": "string"
      }
    },
    "required": [
      "q",
      "limit"
    ],
    "type": "object"
  },
