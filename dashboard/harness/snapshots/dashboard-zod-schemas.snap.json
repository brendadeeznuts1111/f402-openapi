          "player",
          "agent"
        ],
        "type": "string"
      },
      "limit": {
        "default": 500,
        "maximum": 2000,
        "minimum": 1,
        "type": "integer"
      },
      "promotional": {
        "enum": [
          "checked",
          "unchecked"
        ],
        "type": "string"
      },
      "start_date": {
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
        "type": "string"
      },
      "transfers": {
        "enum": [
          "checked",
          "unchecked"
        ],
        "type": "string"
      },
      "type": {
        "enum": [
          "player",
          "agent",
          "deleted",
          "free-play",
          "free-play-analysis",
          "summary"
