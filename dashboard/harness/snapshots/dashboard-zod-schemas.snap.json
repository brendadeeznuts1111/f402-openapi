        "type": "string"
      },
      "agent_id": {
        "minLength": 1,
        "type": "string"
      },
      "balances": {
        "enum": [
          "checked",
          "unchecked"
        ],
        "type": "string"
      },
      "customer_id": {
        "minLength": 1,
        "type": "string"
      },
      "deposits": {
        "enum": [
          "checked",
          "unchecked"
        ],
        "type": "string"
      },
      "distribution": {
        "enum": [
          "checked",
          "unchecked"
        ],
        "type": "string"
      },
      "end_date": {
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
        "type": "string"
      },
      "fees": {
        "enum": [
          "checked",
          "unchecked"
        ],
        "type": "string"
      },
