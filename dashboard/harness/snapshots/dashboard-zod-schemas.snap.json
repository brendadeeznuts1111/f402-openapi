{
  "agentIdSchema": {
    "maxLength": 40,
    "pattern": "^[A-Za-z0-9_*.-]+$",
    "type": "string"
  },
  "agentNavSchema": {
    "additionalProperties": false,
    "properties": {
      "agentId": {
        "maxLength": 40,
        "pattern": "^[A-Za-z0-9_*.-]+$",
        "type": "string"
      }
    },
    "required": [
      "agentId"
    ],
    "type": "object"
  },
  "agentPerformanceFiltersSchema": {
    "additionalProperties": false,
    "properties": {
      "end": {
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
        "type": "string"
      },
      "freePlay": {
        "enum": [
          "Y",
          "N"
        ],
        "type": "string"
      },
      "start": {
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
        "type": "string"
      },
      "type": {
        "enum": [
          "CP",
          "CPS",
          "CPV",
          "G"
        ],
        "type": "string"
      }
    },
    "required": [
      "type",
      "freePlay"
    ],
    "type": "object"
  },
  "agentPerformanceTypeSchema": {
    "enum": [
      "CP",
      "CPS",
      "CPV",
      "G"
    ],
    "type": "string"
  },
  "customerIdSchema": {
    "maxLength": 32,
    "minLength": 1,
    "type": "string"
  },
  "customerNavSchema": {
    "additionalProperties": false,
    "properties": {
      "customerId": {
        "maxLength": 32,
        "minLength": 1,
        "type": "string"
