    "type": "string"
  },
  "transactionReportTypeSchema": {
    "enum": [
      "player",
      "agent",
      "deleted",
      "free-play",
      "free-play-analysis",
      "summary"
    ],
    "type": "string"
  },
  "transactionsLiveFiltersSchema": {
    "additionalProperties": false,
