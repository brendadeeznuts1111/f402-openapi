[Unit]
Description=Fantasy402 headless auth refresh (Puppeteer → /refresh-auth)
After=network-online.target fantasy402-local-proxy.service
Wants=fantasy402-local-proxy.service

[Service]
Type=oneshot
User=%i
WorkingDirectory=%WORKDIR%
EnvironmentFile=-/etc/fantasy402/ingestion.env
ExecStart=/bin/bash scripts/run-with-ingestion-env.sh %BUN% scripts/auth-refresh-if-needed.mjs
StandardOutput=append:/var/log/fantasy402/auth-refresh.log
StandardError=append:/var/log/fantasy402/auth-refresh.err.log

[Install]
WantedBy=multi-user.target
