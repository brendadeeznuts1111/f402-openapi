      "customerId": {
        "maxLength": 32,
        "minLength": 1,
        "type": "string"
      },
      "login": {
        "minLength": 1,
        "type": "string"
      },
      "period": {
        "default": 0,
        "maximum": 52,
        "minimum": 0,
        "type": "integer"
      }
    },
    "required": [
      "customerId",
      "period"
    ],
    "type": "object"
  },
  "freePlaySchema": {
    "enum": [
      "Y",
      "N"
    ],
    "type": "string"
  },
  "isoDateOnlySchema": {
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
  },
  "loginSchema": {
    "maxLength": 64,
    "minLength": 1,
    "type": "string"
  },
  "pendingWagersFiltersSchema": {
    "additionalProperties": false,
    "properties": {
      "customer_id": {
        "default": "0",
        "maxLength": 32,
        "type": "string"
      },
      "date": {
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
        "type": "string"
      },
      "limit": {
        "default": 200,
        "maximum": 500,
        "minimum": 1,
        "type": "integer"
      },
      "login": {
        "default": "",
        "minLength": 1,
        "type": "string"
      },
      "sort": {
        "default": "1",
        "type": "string"
      },
      "sport": {
        "default": "",
        "minLength": 1,
        "type": "string"
      },
      "type_sort": {
        "default": "2",
        "type": "string"
      },
      "wager_type": {
        "default": "",
        "maxLength": 4,
        "type": "string"
      },
      "week": {
        "default": 0,
        "maximum": 52,
        "minimum": 0,
        "type": "integer"
      }
    },
    "required": [
      "customer_id",
      "wager_type",
      "sort",
      "type_sort",
      "week",
      "login",
      "sport",
      "limit"
    ],
    "type": "object"
  },
