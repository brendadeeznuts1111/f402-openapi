# Raw browser/API discovery traces can contain sensitive operational data.
.o11y/*
!.o11y/fantasy402-redacted-deep/
.o11y/fantasy402-redacted-deep/*
!.o11y/fantasy402-redacted-deep/api-spec-secured/
!.o11y/fantasy402-redacted-deep/gap-analysis/

# Keep safe secured contract deliverables, but do not commit full forensic specs.
.o11y/fantasy402-redacted-deep/api-spec-secured/openapi.secured.json
.o11y/fantasy402-redacted-deep/api-spec-secured/openapi.secured.yaml
.o11y/fantasy402-redacted-deep/api-spec-secured/site/openapi.secured.examples.json
.o11y/fantasy402-redacted-deep/api-spec-secured/raw-trace-archive-location.txt

# Local archives and OS files.
*.tar
*.tar.gz
*.tgz
*.zip
.DS_Store
node_modules/

# Local environment secrets
.dev.vars
.env

# Generated harness health report (CI artifact; npm run harness:report)
dashboard/harness/harness-report.json

# Wrangler local build cache
dashboard/.wrangler/
workers/fantasy402-ingestion/.wrangler/

# Local discovery/probing utilities and copied skill internals are not part of
# the secured contract release.
tools/browser-to-api-local/
tools/capture-fantasy402.cjs
