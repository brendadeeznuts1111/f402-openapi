{
  "openapi": "3.1.0",
  "info": {
    "title": "Fantasy402 Ingestion Worker API",
    "version": "0.1.0",
    "description": "Operational API exposed by the Cloudflare Worker that ingests read-only Fantasy402 data into D1 and R2."
  },
  "servers": [
    {
      "url": "https://fantasy402-ingestion.{account}.workers.dev",
      "description": "Cloudflare Workers deployment",
      "variables": {
        "account": {
          "default": "example"
        }
      }
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "Check Worker health",
        "security": [],
        "responses": {
          "200": {
            "description": "Worker is responding",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                },
                "examples": {
                  "ok": {
                    "value": {
                      "status": "ok",
                      "environment": "production"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/trigger": {
      "post": {
        "operationId": "triggerIngestion",
        "summary": "Trigger an ingestion run",
        "security": [
          {
            "triggerToken": []
          }
        ],
        "responses": {
          "202": {
            "description": "Ingestion completed or partially completed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TriggerResponse"
                },
                "examples": {
                  "accepted": {
                    "value": {
                      "runId": "00000000-0000-4000-8000-000000000000",
                      "status": "success",
                      "endpointsSucceeded": 3,
                      "endpointsFailed": 0
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid trigger token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "unauthorized": {
                    "value": {
                      "status": "failed",
                      "message": "Unauthorized"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Ingestion failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TriggerResponse"
                }
              }
            }
          }
        }
      }
    },
    "/archive": {
      "get": {
        "operationId": "listArchiveObjects",
        "summary": "List archived R2 objects",
        "security": [
          {
            "triggerToken": []
          }
        ],
        "parameters": [
          {
            "name": "prefix",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "fantasy402"
            },
            "description": "R2 key prefix to list. Must resolve under fantasy402/."
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000,
              "default": 50
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Archive object listing",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ArchiveListResponse"
                },
                "examples": {
                  "listing": {
                    "value": {
                      "objects": [
                        {
                          "key": "fantasy402/getAgentPerformance/2026-05-17/00000000-0000-4000-8000-000000000000.json",
                          "etag": "00000000000000000000000000000000",
                          "size": 512,
                          "uploaded": "2026-05-17T00:00:00.000Z",
                          "storageClass": "InfrequentAccess",
                          "httpMetadata": {
                            "contentType": "application/json; charset=utf-8",
                            "cacheControl": "no-store, max-age=0"
                          },
                          "customMetadata": {
                            "source": "fantasy402",
                            "endpoint": "getAgentPerformance",
                            "archiveType": "success"
                          }
                        }
                      ],
                      "truncated": false,
                      "cursor": null
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid trigger token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/archive/object": {
      "get": {
        "operationId": "getArchiveObject",
        "summary": "Read an archived R2 object",
        "security": [
          {
            "triggerToken": []
          }
        ],
        "parameters": [
          {
            "name": "key",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^fantasy402/.+\\.json$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Archived JSON object",
            "headers": {
              "ETag": {
                "schema": {
                  "type": "string"
                }
              },
              "X-Archive-Key": {
                "schema": {
                  "type": "string"
                }
              },
              "X-Archive-Storage-Class": {
                "schema": {
                  "type": "string"
                }
              },
              "X-Archive-Size": {
                "schema": {
                  "type": "integer"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Invalid or missing key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid trigger token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Archive object not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "triggerToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "Manual ingestion trigger token stored as INGESTION_TRIGGER_TOKEN."
      }
    },
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "required": [
          "status",
          "environment"
        ],
        "additionalProperties": false,
        "properties": {
          "status": {
            "type": "string",
            "const": "ok"
          },
          "environment": {
            "type": "string"
          }
        }
      },
      "TriggerResponse": {
        "type": "object",
        "required": [
          "runId",
          "status",
          "endpointsSucceeded",
          "endpointsFailed"
        ],
        "additionalProperties": false,
        "properties": {
          "runId": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "success",
              "failed"
            ]
          },
          "endpointsSucceeded": {
            "type": "integer",
            "minimum": 0
          },
          "endpointsFailed": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "status",
          "message"
        ],
        "additionalProperties": false,
        "properties": {
          "status": {
            "type": "string",
            "const": "failed"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "ArchiveObjectSummary": {
        "type": "object",
        "required": [
          "key",
          "etag",
          "size",
          "uploaded",
          "storageClass",
          "httpMetadata",
          "customMetadata"
        ],
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string"
          },
          "etag": {
            "type": "string"
          },
          "size": {
            "type": "integer",
            "minimum": 0
          },
          "uploaded": {
            "type": "string",
            "format": "date-time"
          },
          "storageClass": {
            "type": "string"
          },
          "httpMetadata": {
            "type": "object"
          },
          "customMetadata": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      },
      "ArchiveListResponse": {
        "type": "object",
        "required": [
          "objects",
          "truncated",
          "cursor"
        ],
        "additionalProperties": false,
        "properties": {
          "objects": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ArchiveObjectSummary"
            }
          },
          "truncated": {
            "type": "boolean"
          },
          "cursor": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
