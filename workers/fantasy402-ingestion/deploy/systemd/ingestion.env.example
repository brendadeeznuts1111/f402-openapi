# Copy to /etc/fantasy402/ingestion.env and restrict permissions (chmod 600).
# Used by fantasy402 systemd units.

# Real Cloudflare Worker (proxy upstream target)
FANTASY402_WORKER_UPSTREAM=https://fantasy402-ingestion.utahj4754.workers.dev

# CLI + ingest batch scripts talk to the local proxy
WORKER_ORIGIN=http://127.0.0.1:8791
LOCAL_INGEST_PROXY_PORT=8791

INGESTION_TRIGGER_TOKEN=

FANTASY402_USERNAME=
FANTASY402_PASSWORD=

# Optional overrides
# FANTASY402_CUSTOMER_ID=
# FANTASY402_BROWSER_AUTH_FILE=/opt/fantasy402/fantasy402/browser-auth.json
# F402_AUTO_REFRESH_AUTH=1
# F402_JWT_REFRESH_BUFFER_SEC=900
# F402_JWT_INGEST_MIN_TTL_SEC=120
# F402_MAX_INGEST_LOOPS=8
# F402_CYCLE_BACKOFF_MS=60000
# F402_ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...
# F402_ALERT_FAILURE_THRESHOLD=3
# F402_ALERT_COOLDOWN_MS=3600000
# F402_ALERT_WEBHOOK_STYLE=slack
# Worker cron: skip useless /trigger 403s (use local ingest instead)
# FANTASY402_WORKER_TRIGGER_MODE=skip
# AUTH_HEALTH_JWT_BUFFER_SEC=300
