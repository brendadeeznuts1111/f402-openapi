      "limit"
    ],
    "type": "object"
  },
  "wagerLinkSchema": {
    "additionalProperties": false,
    "properties": {
      "customerId": {
        "minLength": 1,
        "type": "string"
      },
      "login": {
        "minLength": 1,
        "type": "string"
      },
      "ticketNumber": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "number"
          }
        ]
      }
    },
    "type": "object"
  }
}
