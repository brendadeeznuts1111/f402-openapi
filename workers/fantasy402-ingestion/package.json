{
  "name": "fantasy402-ingestion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "audit": "npm audit --audit-level=moderate",
    "validate:deploy-config": "node scripts/validate-deploy-config.mjs",
    "validate:openapi": "node scripts/validate-worker-openapi.mjs",
    "validate:upstream-contract": "node scripts/validate-upstream-contract.mjs",
    "validate:runtime-auth": "node scripts/validate-runtime-auth-contract.mjs",
    "bootstrap:cloudflare": "node scripts/bootstrap-cloudflare-resources.mjs",
    "bootstrap:cloudflare:apply": "node scripts/bootstrap-cloudflare-resources.mjs --apply",
    "bootstrap:cloudflare:self-test": "node scripts/bootstrap-cloudflare-resources.mjs --self-test",
    "cron:status": "node scripts/manage-cron-triggers.mjs",
    "cron:enable": "node scripts/manage-cron-triggers.mjs --enable",
    "cron:disable": "node scripts/manage-cron-triggers.mjs --disable",
    "secrets:worker": "node scripts/set-worker-secrets.mjs",
    "secrets:worker:apply": "node scripts/set-worker-secrets.mjs --apply",
    "viewer:proxy": "node scripts/static-viewer-proxy.mjs",
    "ingest:proxy": "bun scripts/local-ingest-proxy.ts",
    "smoke:remote": "node scripts/smoke-deployed-worker.mjs",
    "auth:import-curl": "node scripts/import-browser-curl.mjs",
    "auth:import-clipboard": "node scripts/import-browser-curl.mjs fantasy402/browser-request.curl",
    "auth:check": "node scripts/check-browser-auth.mjs",
    "auth:refresh-full": "tsx scripts/refresh-auth-full/refresh-auth-full.ts",
    "auth:refresh-if-needed": "bun scripts/auth-refresh-if-needed.mjs",
    "auth:post-payload": "bun scripts/post-refresh-payload.mjs",
    "auth:preflight": "bun scripts/auth-stack-preflight.mjs",
    "auth:stack-status": "bun scripts/auth-stack-status.mjs",
    "auth:monitor": "bun scripts/monitor-auth-stack.mjs",
    "verify:deployed": "bun scripts/post-deploy-verify.mjs",
    "auth:check-stack": "bun scripts/check-auth-stack.mjs",
    "ingest:unattended-cycle": "bun scripts/run-unattended-cycle.mjs",
    "dev:ingest-stack": "bun scripts/dev-ingest-stack.mjs",
    "ingest:dry-run": "node scripts/ingestion-dry-run.mjs",
    "ingest:browser": "node scripts/local-browser-ingest.mjs",
    "ingest:curl": "node scripts/ingest-from-browser-curl.mjs",
    "ingest:clipboard": "node scripts/ingest-from-browser-curl.mjs fantasy402/browser-request.curl",
    "ingest:unblock": "node scripts/unblock-production-ingestion.mjs",
    "sync:ingest": "node scripts/unblock-production-ingestion.mjs",
    "ingest:local-batch": "bun scripts/ingest-local-batch.mjs",
    "ingest:local-all": "bun scripts/ingest-local-batch.mjs --all",
    "ingest:install-cron": "bash scripts/install-ingest-cron.sh",
    "ingest:install-mac-stack": "bash deploy/launchd/install-mac-auth-stack.sh",
    "verify": "npm run verify:deploy",
    "verify:deploy": "npm run test && npm run auth:check-stack -- --offline && npm run bootstrap:cloudflare:self-test && npm run audit && npm run validate:openapi && npm run validate:upstream-contract && npm run validate:runtime-auth",
    "verify:full": "npm run typecheck && npm run verify:deploy",
    "sync:production-token": "bash scripts/sync-production-token.sh",
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "migrate:local": "wrangler d1 migrations apply fantasy402-analytics --local",
    "migrate:remote": "wrangler d1 migrations apply fantasy402-analytics --remote",
    "verify:cf-token": "node scripts/verify-cloudflare-api-token.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260118.0",
    "@types/node": "25.1.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "zod": "^4.3.6"
  }
}
