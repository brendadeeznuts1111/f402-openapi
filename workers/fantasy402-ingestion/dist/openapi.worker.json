{
  "openapi": "3.1.0",
  "info": {
    "title": "Fantasy402 Ingestion Worker API",
    "version": "0.1.0",
    "description": "Operational API exposed by the Cloudflare Worker that ingests read-only Fantasy402 data into D1 and R2."
  },
  "servers": [
    {
      "url": "https://fantasy402-ingestion.{account}.workers.dev",
      "description": "Cloudflare Workers deployment",
      "variables": {
        "account": {
          "default": "example"
        }
      }
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "Check Worker health",
        "security": [],
        "responses": {
          "200": {
            "description": "Worker is responding",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                },
                "examples": {
                  "ok": {
                    "value": {
                      "status": "ok",
                      "environment": "production"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/trigger": {
      "post": {
        "operationId": "triggerIngestion",
        "summary": "Trigger an ingestion run",
        "security": [
          {
            "triggerToken": []
          }
        ],
        "responses": {
          "202": {
            "description": "Ingestion completed or partially completed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TriggerResponse"
                },
                "examples": {
                  "accepted": {
                    "value": {
                      "runId": "00000000-0000-4000-8000-000000000000",
                      "status": "success",
                      "endpointsSucceeded": 3,
                      "endpointsFailed": 0
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid trigger token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "unauthorized": {
                    "value": {
                      "success": false,
                      "error": {
                        "code": "AUTH_001",
                        "message": "Unauthorized"
                      }
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Ingestion failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TriggerResponse"
                }
              }
            }
          }
        }
      }
    },
    "/settings": {
      "get": {
        "operationId": "getSettings",
        "summary": "Read harness settings defaults",
        "security": [
          {
            "triggerToken": []
          }
        ],
        "responses": {
          "200": {
            "description": "Current settings defaults",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SettingsSchema"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid trigger token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/settings/schema": {
      "get": {
        "operationId": "getSettingsSchema",
        "summary": "Read settings schema metadata",
        "security": [
          {
            "triggerToken": []
          }
        ],
        "responses": {
          "200": {
            "description": "Settings schema metadata",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SettingsSchemaDescription"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid trigger token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/settings/validate": {
      "post": {
        "operationId": "validateSettings",
        "summary": "Validate settings payload",
        "security": [
          {
            "triggerToken": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SettingsSchema"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Validated settings payload",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SettingsSchema"
                }
              }
            }
          },
          "400": {
            "description": "Invalid settings payload",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid trigger token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/agents": {
      "get": {
        "operationId": "listAgents",
        "summary": "List configured LLM agents",
        "security": [
          {
            "triggerToken": []
          }
        ],
        "responses": {
          "200": {
            "description": "Agent registry",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentRegistryResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid trigger token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/agents/health": {
      "get": {
        "operationId": "getAgentHealth",
        "summary": "Check health for configured LLM agents",
        "security": [
          {
            "triggerToken": []
          }
        ],
        "responses": {
          "200": {
            "description": "Agent health",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentHealthResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid trigger token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/archive": {
      "get": {
        "operationId": "listArchiveObjects",
        "summary": "List archived R2 objects",
        "security": [
          {
            "triggerToken": []
          }
        ],
        "parameters": [
          {
            "name": "prefix",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "fantasy402"
            },
            "description": "R2 key prefix to list. Must resolve under fantasy402/."
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000,
              "default": 50
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Archive object listing",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ArchiveListResponse"
                },
                "examples": {
                  "listing": {
                    "value": {
                      "objects": [
                        {
                          "key": "fantasy402/getAgentPerformance/2026-05-17/00000000-0000-4000-8000-000000000000.json",
                          "etag": "00000000000000000000000000000000",
                          "size": 512,
                          "uploaded": "2026-05-17T00:00:00.000Z",
                          "storageClass": "InfrequentAccess",
                          "httpMetadata": {
                            "contentType": "application/json; charset=utf-8",
                            "cacheControl": "no-store, max-age=0"
                          },
                          "customMetadata": {
                            "source": "fantasy402",
                            "endpoint": "getAgentPerformance",
                            "archiveType": "success"
                          }
                        }
                      ],
                      "truncated": false,
                      "cursor": null
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid trigger token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/archive/viewer": {
      "get": {
        "operationId": "getArchiveViewer",
        "summary": "Serve the operator archive viewer",
        "security": [],
        "responses": {
          "200": {
            "description": "HTML operator viewer",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/archive/object": {
      "get": {
        "operationId": "getArchiveObject",
        "summary": "Read an archived R2 object",
        "security": [
          {
            "triggerToken": []
          }
        ],
        "parameters": [
          {
            "name": "key",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^fantasy402/.+\\.json$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Archived JSON object",
            "headers": {
              "ETag": {
                "schema": {
                  "type": "string"
                }
              },
              "X-Archive-Key": {
                "schema": {
                  "type": "string"
                }
              },
              "X-Archive-Storage-Class": {
                "schema": {
                  "type": "string"
                }
              },
              "X-Archive-Size": {
                "schema": {
                  "type": "integer"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Invalid or missing key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid trigger token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Archive object not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/scans": {
      "get": {
        "operationId": "listScanVerdicts",
        "summary": "List recent Cloudflare URL Scanner verdicts",
        "security": [
          {
            "triggerToken": []
          }
        ],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Recent scan verdict rows",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScanListResponse"
                },
                "examples": {
                  "recent": {
                    "value": {
                      "results": [
                        {
                          "scan_id": "00000000-0000-4000-8000-000000000000",
                          "timestamp": "2026-05-17T00:00:00.000Z",
                          "url": "https://fantasy402.com",
                          "malicious": 0,
                          "tls_valid_days": 42,
                          "agent_readiness_level": 1,
                          "scan_r2_key": "fantasy402/scans/2026-05-17/00000000-0000-4000-8000-000000000000.json",
                          "screenshot_r2_key": "fantasy402/screenshots/00000000-0000-4000-8000-000000000000_desktop.png",
                          "har_r2_key": "fantasy402/hars/00000000-0000-4000-8000-000000000000.har"
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid trigger token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/scans/trigger": {
      "post": {
        "operationId": "triggerUrlScan",
        "summary": "Trigger a Cloudflare URL Scanner run",
        "security": [
          {
            "triggerToken": []
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ScanTriggerRequest"
              },
              "examples": {
                "defaultTarget": {
                  "value": {
                    "url": "https://fantasy402.com"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Scan completed and verdict was stored",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScanTriggerResponse"
                },
                "examples": {
                  "accepted": {
                    "value": {
                      "scanId": "00000000-0000-4000-8000-000000000000",
                      "url": "https://fantasy402.com",
                      "malicious": false,
                      "tlsValidDays": 42
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid scan target URL",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid trigger token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Scan failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "triggerToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "Manual ingestion trigger token stored as INGESTION_TRIGGER_TOKEN."
      }
    },
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "required": [
          "status",
          "environment"
        ],
        "additionalProperties": false,
        "properties": {
          "status": {
            "type": "string",
            "const": "ok"
          },
          "environment": {
            "type": "string"
          }
        }
      },
      "TriggerResponse": {
        "type": "object",
        "required": [
          "runId",
          "status",
          "endpointsSucceeded",
          "endpointsFailed"
        ],
        "additionalProperties": false,
        "properties": {
          "runId": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "success",
              "failed"
            ]
          },
          "endpointsSucceeded": {
            "type": "integer",
            "minimum": 0
          },
          "endpointsFailed": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "success",
          "error"
        ],
        "additionalProperties": false,
        "properties": {
          "success": {
            "type": "boolean",
            "const": false
          },
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "AUTH_001",
                  "VALIDATION_001",
                  "NOT_FOUND_001",
                  "RATE_LIMIT_002",
                  "UPSTREAM_001",
                  "LLM_TIMEOUT",
                  "LLM_INVALID_RESPONSE"
                ]
              },
              "message": {
                "type": "string"
              },
              "details": {}
            }
          }
        }
      },
      "ArchiveObjectSummary": {
        "type": "object",
        "required": [
          "key",
          "etag",
          "size",
          "uploaded",
          "storageClass",
          "httpMetadata",
          "customMetadata"
        ],
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string"
          },
          "etag": {
            "type": "string"
          },
          "size": {
            "type": "integer",
            "minimum": 0
          },
          "uploaded": {
            "type": "string",
            "format": "date-time"
          },
          "storageClass": {
            "type": "string"
          },
          "httpMetadata": {
            "type": "object"
          },
          "customMetadata": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      },
      "ArchiveListResponse": {
        "type": "object",
        "required": [
          "objects",
          "truncated",
          "cursor"
        ],
        "additionalProperties": false,
        "properties": {
          "objects": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ArchiveObjectSummary"
            }
          },
          "truncated": {
            "type": "boolean"
          },
          "cursor": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "ScanVerdict": {
        "type": "object",
        "required": [
          "scan_id",
          "timestamp",
          "url",
          "malicious",
          "tls_valid_days",
          "agent_readiness_level",
          "scan_r2_key",
          "screenshot_r2_key",
          "har_r2_key"
        ],
        "additionalProperties": false,
        "properties": {
          "scan_id": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https?://"
          },
          "malicious": {
            "type": "integer",
            "enum": [
              0,
              1
            ]
          },
          "tls_valid_days": {
            "type": [
              "integer",
              "null"
            ]
          },
          "agent_readiness_level": {
            "type": [
              "integer",
              "null"
            ]
          },
          "scan_r2_key": {
            "type": [
              "string",
              "null"
            ]
          },
          "screenshot_r2_key": {
            "type": [
              "string",
              "null"
            ]
          },
          "har_r2_key": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "ScanListResponse": {
        "type": "object",
        "required": [
          "results"
        ],
        "additionalProperties": false,
        "properties": {
          "results": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ScanVerdict"
            }
          }
        }
      },
      "ScanTriggerRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https?://",
            "default": "https://fantasy402.com"
          }
        }
      },
      "ScanTriggerResponse": {
        "type": "object",
        "required": [
          "scanId",
          "url",
          "malicious",
          "tlsValidDays"
        ],
        "additionalProperties": false,
        "properties": {
          "scanId": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https?://"
          },
          "malicious": {
            "type": "boolean"
          },
          "tlsValidDays": {
            "type": [
              "integer",
              "null"
            ]
          }
        }
      },
      "SettingsSchema": {
        "type": "object",
        "required": [
          "archivePrefix",
          "archiveListLimit",
          "scanListLimit",
          "defaultScanUrl",
          "screenshots",
          "agentReadiness"
        ],
        "additionalProperties": false,
        "properties": {
          "archivePrefix": {
            "type": "string",
            "pattern": "^fantasy402/"
          },
          "archiveListLimit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          },
          "scanListLimit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "defaultScanUrl": {
            "type": "string",
            "format": "uri",
            "pattern": "^https?://"
          },
          "screenshots": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2,
            "items": {
              "type": "string",
              "enum": [
                "desktop",
                "mobile"
              ]
            }
          },
          "agentReadiness": {
            "type": "boolean"
          }
        }
      },
      "SettingsSchemaDescription": {
        "type": "object",
        "required": [
          "name",
          "fields"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "const": "SettingsSchema"
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "AgentRegistryResponse": {
        "type": "object",
        "required": [
          "agents"
        ],
        "additionalProperties": false,
        "properties": {
          "agents": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "capability",
                "invocation",
                "route"
              ],
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "enum": [
                    "Summarizer",
                    "Router",
                    "CodeGen"
                  ]
                },
                "capability": {
                  "type": "string"
                },
                "invocation": {
                  "type": "string"
                },
                "route": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "AgentInput": {
        "type": "object",
        "required": [
          "agentId",
          "requestId",
          "prompt"
        ],
        "additionalProperties": false,
        "properties": {
          "agentId": {
            "type": "string",
            "enum": [
              "Summarizer",
              "Router",
              "CodeGen"
            ]
          },
          "requestId": {
            "type": "string"
          },
          "prompt": {
            "type": "string"
          },
          "context": {
            "type": "object"
          }
        }
      },
      "AgentOutput": {
        "type": "object",
        "required": [
          "agentId",
          "requestId",
          "success",
          "content"
        ],
        "additionalProperties": false,
        "properties": {
          "agentId": {
            "type": "string",
            "enum": [
              "Summarizer",
              "Router",
              "CodeGen"
            ]
          },
          "requestId": {
            "type": "string"
          },
          "success": {
            "type": "boolean"
          },
          "content": {
            "type": "string"
          },
          "usage": {
            "type": "object"
          },
          "error": {
            "type": "object"
          }
        }
      },
      "AgentHealthResponse": {
        "type": "object",
        "required": [
          "agents"
        ],
        "additionalProperties": false,
        "properties": {
          "agents": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "status",
                "capability",
                "invocation"
              ],
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "enum": [
