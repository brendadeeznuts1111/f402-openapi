      "login": {
        "minLength": 1,
        "type": "string"
      }
    },
    "required": [
      "customerId"
    ],
    "type": "object"
  },
  "customerProfilePathSchema": {
    "additionalProperties": false,
    "properties": {
      "analysis": {
        "additionalProperties": false,
        "properties": {
          "end": {
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "type": "string"
          },
          "lineType": {
            "default": 2,
            "maximum": 9,
            "minimum": 0,
            "type": "integer"
          },
          "reportType": {
            "default": 2,
            "maximum": 9,
            "minimum": 0,
            "type": "integer"
